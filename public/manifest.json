{
  "manifest_version": 3,
  "name": "Moodlens",
  "short_name": "Moodlens",
  "version": "0.1.0",
  "description": "All in One Moodle AI Agent for Student. Independent EN/ID study companion; not affiliated with Moodle Pty Ltd.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "sidePanel"
  ],
  "host_permissions": [],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Moodlens"
  },
  "content_scripts": [
    {
      "matches": [
        "https://solusi.sibermu.ac.id/course/view.php*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
